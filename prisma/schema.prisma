generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// CAMPAIGNS & VARIANTS
// ============================================

model Campaign {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  status        CampaignStatus @default(ACTIVE)
  trafficSource String
  offerUrl      String
  offerId       String
  adSpend          Float?
  geoGate          Boolean        @default(false)
  shortCode        String?        @unique
  optimizationMode String         @default("STATIC") // STATIC | BANDIT
  startsAt         DateTime?
  endsAt           DateTime?
  variants      Variant[]
  clicks        Click[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([slug])
  @@index([status])
}

enum CampaignStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

model Variant {
  id            String   @id @default(cuid())
  campaign      Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId    String
  name          String
  slug          String
  theme         Json
  content       Json
  trafficWeight        Int      @default(50)
  isControl            Boolean  @default(false)
  creativeMetadata     Json?
  cumulativeClicks     Int      @default(0)  // used by Multi-Armed Bandit
  cumulativeConversions Int     @default(0)  // used by Multi-Armed Bandit
  clicks           Click[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([campaignId, slug])
  @@index([campaignId])
}

// ============================================
// CLICK TRACKING
// ============================================

model Click {
  id           String      @id @default(cuid())
  campaign     Campaign    @relation(fields: [campaignId], references: [id])
  campaignId   String
  variant      Variant     @relation(fields: [variantId], references: [id])
  variantId    String
  ipAddress    String?
  userAgent    String?
  country      String?
  city         String?
  device       DeviceType?
  os           String?
  browser      String?
  referrer     String?
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  utmContent   String?
  utmTerm      String?
  vibe         String?
  language     String?     // primary Accept-Language tag e.g. "en", "de"
  cost         String?     // per-click cost from traffic source (?cost=0.05)
  externalId   String?     // traffic source click ID (?externalid=xxx)
  isBot        Boolean     @default(false)
  customParams Json?
  pageViews    Int         @default(1)
  timeOnPage   Int?
  scrollDepth  Int?
  ctaClicked   Boolean     @default(false)
  landed       Boolean     @default(false)
  clickedAt    DateTime?
  converted    Boolean     @default(false)
  conversion   Conversion?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([campaignId])
  @@index([variantId])
  @@index([country])
  @@index([createdAt])
  @@index([converted])
}

enum DeviceType {
  MOBILE
  DESKTOP
  TABLET
}

// ============================================
// CONVERSION TRACKING
// ============================================

model Conversion {
  id           String          @id @default(cuid())
  click        Click           @relation(fields: [clickId], references: [id])
  clickId      String          @unique
  eventType    ConversionEvent
  payoutAmount Decimal?        @db.Decimal(10, 2)
  playerValue  Decimal?        @db.Decimal(10, 2)
  currency     String          @default("EUR")
  playerId     String?
  postbackData Json?
  createdAt    DateTime        @default(now())

  @@index([clickId])
  @@index([eventType])
  @@index([createdAt])
}

enum ConversionEvent {
  REGISTRATION
  FTD
  REDEPOSIT
}
