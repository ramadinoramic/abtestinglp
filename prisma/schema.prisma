generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// CAMPAIGNS & VARIANTS
// ============================================

model Campaign {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  status        CampaignStatus @default(ACTIVE)
  trafficSource String
  offerUrl      String
  offerId       String
  variants      Variant[]
  clicks        Click[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([slug])
  @@index([status])
}

enum CampaignStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

model Variant {
  id            String   @id @default(cuid())
  campaign      Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId    String
  name          String
  slug          String
  theme         Json
  content       Json
  trafficWeight Int      @default(50)
  isControl     Boolean  @default(false)
  clicks        Click[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([campaignId, slug])
  @@index([campaignId])
}

// ============================================
// CLICK TRACKING
// ============================================

model Click {
  id           String      @id @default(cuid())
  campaign     Campaign    @relation(fields: [campaignId], references: [id])
  campaignId   String
  variant      Variant     @relation(fields: [variantId], references: [id])
  variantId    String
  ipAddress    String?
  userAgent    String?
  country      String?
  city         String?
  device       DeviceType?
  os           String?
  browser      String?
  referrer     String?
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  utmContent   String?
  utmTerm      String?
  customParams Json?
  pageViews    Int         @default(1)
  timeOnPage   Int?
  scrollDepth  Int?
  ctaClicked   Boolean     @default(false)
  clickedAt    DateTime?
  converted    Boolean     @default(false)
  conversion   Conversion?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([campaignId])
  @@index([variantId])
  @@index([country])
  @@index([createdAt])
  @@index([converted])
}

enum DeviceType {
  MOBILE
  DESKTOP
  TABLET
}

// ============================================
// CONVERSION TRACKING
// ============================================

model Conversion {
  id           String          @id @default(cuid())
  click        Click           @relation(fields: [clickId], references: [id])
  clickId      String          @unique
  eventType    ConversionEvent
  payoutAmount Decimal?        @db.Decimal(10, 2)
  playerValue  Decimal?        @db.Decimal(10, 2)
  currency     String          @default("EUR")
  playerId     String?
  postbackData Json?
  createdAt    DateTime        @default(now())

  @@index([clickId])
  @@index([eventType])
  @@index([createdAt])
}

enum ConversionEvent {
  REGISTRATION
  FTD
  REDEPOSIT
}
